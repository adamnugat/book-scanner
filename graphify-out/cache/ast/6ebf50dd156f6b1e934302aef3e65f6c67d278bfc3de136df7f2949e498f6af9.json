Type': 'application/json' },\n        body: JSON.stringify({ refreshToken }),\n      });\n\n      if (!res.ok) {\n        if (res.status === 401) {\n          await tokenStorage.clear();\n        }\n        return false;\n      }\n\n      const data = (await res.json()) as AuthResponse;\n      await tokenStorage.setTokens(data.accessToken, data.refreshToken);\n      return true;\n    })", "is_member_call": false, "source_file": "/Users/awieczorek/dev/book-scaner/apps/mobile/lib/api.ts", "source_location": "L29"}, {"caller_nid": "lib_api_apifetch", "callee": "getAccessToken", "is_member_call": true, "source_file": "/Users/awieczorek/dev/book-scaner/apps/mobile/lib/api.ts", "source_location": "L58"}, {"caller_nid": "lib_api_apifetch", "callee": "fetch", "is_member_call": false, "source_file": "/Users/awieczorek/dev/book-scaner/apps/mobile/lib/api.ts", "source_location": "L67"}, {"caller_nid": "lib_api_apifetch", "callee": "catch", "is_member_call": true, "source_file": "/Users/awieczorek/dev/book-scaner/apps/mobile/lib/api.ts", "source_location": "L77"}, {"caller_nid": "lib_api_apifetch", "callee": "json", "is_member_call": true, "source_file": "/Users/awieczorek/dev/book-scaner/apps/mobile/lib/api.ts", "source_location": "L77"}, {"caller_nid": "lib_api_apifetch", "callee": "json", "is_member_call": true, "source_file": "/Users/awieczorek/dev/book-scaner/apps/mobile/lib/api.ts", "source_location": "L85"}]}