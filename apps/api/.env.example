# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookscanner?schema=public"

# Server
PORT=3001
NODE_ENV=development

# Auth (JWT)
JWT_SECRET=change-me-to-a-random-secret-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Storage (S3-compatible — MinIO for local dev, AWS S3 / Cloudflare R2 for production)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=book-scanner

# OCR
# Use "mock" for local development without Google Cloud credentials.
OCR_PROVIDER=mock
#
# To enable Google Cloud Vision OCR:
# 1. Save the service account JSON outside this repository, for example:
#    /Users/<user>/secrets/book-scanner-google-vision.json
# 2. Set OCR_PROVIDER=google
# 3. Point GOOGLE_APPLICATION_CREDENTIALS to the absolute JSON file path.
#
# Do not commit the real JSON key. Required service account fields are:
# project_id, client_email, and private_key.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-vision-service-account.json
#
# Optional deployment-only alternatives when a JSON file cannot be mounted:
# GOOGLE_CLOUD_CREDENTIALS_JSON={"project_id":"...","client_email":"...","private_key":"..."}
# GOOGLE_CLOUD_PROJECT_ID=...
# GOOGLE_CLOUD_CLIENT_EMAIL=...
# GOOGLE_CLOUD_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
