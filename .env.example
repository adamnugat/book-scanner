# ===========================================
# Book Scanner — Environment Variables
# ===========================================
# Copy this file to .env and fill in the values.
# Do NOT commit .env to version control.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bookscanner?schema=public"

# --- API Server ---
PORT=3001
NODE_ENV=development

# --- Storage (S3-compatible) ---
# Local dev: use MinIO (docker run -p 9000:9000 minio/minio server /data)
# Production: AWS S3, Cloudflare R2, or similar
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=book-scanner

# --- ElevenLabs (TTS) — needed from Iteration 6 ---
# ELEVENLABS_API_KEY=

# --- Google Cloud Vision (OCR) — needed from Iteration 4 ---
# GOOGLE_CLOUD_CREDENTIALS=

# --- Expo ---
# EXPO_PUBLIC_API_URL=http://localhost:3001
