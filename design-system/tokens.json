{
  "$schema": "AudioFlow design tokens — extracted from project HTML/CSS",
  "meta": {
    "name": "AudioFlow Glass",
    "description": "Glassmorphic, warm-burgundy mobile UI for an audiobook studio app. Optimized for dark, pearl-accented surfaces over an ambient rose-burgundy background.",
    "version": "1.0.0",
    "mode": "dark",
    "viewport": { "max-width": "480px", "min-height": "884px" }
  },

  "color": {
    "background": {
      "hero-base":   "#6b4c4c",
      "hero-radial-1": "rgba(204, 153, 153, 0.5)",
      "hero-radial-2": "rgba(179, 128, 128, 0.4)",
      "hero-radial-3": "rgba(153, 102, 102, 0.5)",
      "surface-muted": "#1b1b1e",
      "deep-1": "#2a1a1d",
      "deep-2": "#150b10"
    },
    "surface": {
      "glass":        "rgba(45, 30, 30, 0.45)",
      "glass-muted":  "rgba(45, 30, 30, 0.35)",
      "glass-light":  "rgba(255, 255, 255, 0.06)",
      "glass-lighter":"rgba(255, 255, 255, 0.08)",
      "glass-hover":  "rgba(255, 255, 255, 0.12)",
      "glass-edge":   "rgba(15, 10, 11, 0.6)"
    },
    "accent": {
      "pearl":        "#F0EAD6",
      "pearl-bright": "#FBFCF8",
      "pearl-glow":   "rgba(240, 234, 214, 0.4)",
      "pearl-glow-strong": "rgba(240, 234, 214, 0.85)",
      "pearl-border": "rgba(240, 234, 214, 0.55)",
      "pearl-tint":   "rgba(240, 234, 214, 0.10)",
      "secondary-pink":  "rgba(255, 177, 200, 0.45)",
      "secondary-green": "rgba(139, 168, 142, 0.30)"
    },
    "text": {
      "on-dark":          "#FFFFFF",
      "on-pearl":         "#131316",
      "on-surface-subtle":"#d4c0d7",
      "on-surface-muted": "rgba(255, 255, 255, 0.6)"
    },
    "state": {
      "live-dot": "#F0EAD6",
      "disabled-opacity": 0.35
    }
  },

  "typography": {
    "families": {
      "headline": "\"Quicksand\", system-ui, sans-serif",
      "body":     "\"Varela Round\", system-ui, sans-serif",
      "mono":     "ui-monospace, SFMono-Regular, Menlo, monospace",
      "icon":     "\"Material Symbols Outlined\""
    },
    "scale": {
      "headline-lg": { "size": "32px", "lineHeight": "40px", "weight": 700, "letterSpacing": "-0.02em", "family": "headline" },
      "headline-md": { "size": "24px", "lineHeight": "32px", "weight": 600, "family": "headline" },
      "body-lg":     { "size": "18px", "lineHeight": "28px", "weight": 400, "family": "body" },
      "body-md":     { "size": "16px", "lineHeight": "24px", "weight": 400, "family": "body" },
      "label-md":    { "size": "14px", "lineHeight": "20px", "weight": 600, "letterSpacing": "0.01em", "family": "body" },
      "label-sm":    { "size": "12px", "lineHeight": "16px", "weight": 500, "family": "body" }
    },
    "tracking": {
      "eyebrow":      "0.18em",
      "status":       "0.14em"
    },
    "effects": {
      "glow-text": "0 0 12px rgba(255, 255, 255, 0.3)"
    }
  },

  "spacing": {
    "stack-sm":     "8px",
    "stack-md":     "16px",
    "stack-lg":     "32px",
    "section-gap":  "48px",
    "gutter-mobile":"16px",
    "margin-mobile":"20px"
  },

  "radius": {
    "sm":  "0.25rem",
    "md":  "0.5rem",
    "lg":  "0.75rem",
    "card":"16px",
    "panel":"24px",
    "full":"9999px"
  },

  "elevation": {
    "pearl-cta":      "0 4px 20px rgba(240, 234, 214, 0.4)",
    "pearl-glow":     "0 0 12px rgba(240, 234, 214, 0.9)",
    "pearl-soft":     "0 0 22px rgba(240, 234, 214, 0.18)",
    "nav-shadow":     "0 -4px 20px rgba(0, 0, 0, 0.2)",
    "inset-highlight":"inset 1px 1px 0 rgba(255, 255, 255, 0.1)",
    "inset-highlight-faint": "inset 1px 1px 0 rgba(255, 255, 255, 0.08)"
  },

  "blur": {
    "glass": "3px"
  },

  "motion": {
    "duration": {
      "fast":  "120ms",
      "base":  "200ms",
      "slow":  "220ms",
      "pulse": "2400ms"
    },
    "easing": {
      "standard": "ease",
      "ease-in-out": "ease-in-out"
    },
    "keyframes": {
      "pulseGlow": {
        "0%, 100%": { "box-shadow": "0 4px 24px rgba(240, 234, 214, 0.45)" },
        "50%":      { "box-shadow": "0 4px 36px rgba(240, 234, 214, 0.85)" }
      }
    }
  },

  "iconography": {
    "system": "Material Symbols Outlined",
    "axes": { "wght": "100..700", "FILL": "0..1" },
    "default-size": "24px",
    "primary-tint": "#F0EAD6"
  },

  "layout": {
    "app-container": "max-width: 480px; margin: 0 auto;",
    "top-bar-height": "56px",
    "bottom-nav-height": "64px",
    "fab-size": "56px"
  },

  "components": {
    "glass-panel": {
      "background": "rgba(45, 30, 30, 0.45)",
      "backdrop-filter": "blur(3px)",
      "border": "1px solid rgba(15, 10, 11, 0.6)",
      "box-shadow": "inset 1px 1px 0 rgba(255, 255, 255, 0.1)",
      "border-radius": "24px"
    },
    "glass-panel-light": {
      "background": "rgba(255, 255, 255, 0.06)",
      "backdrop-filter": "blur(3px)",
      "border": "1px solid rgba(15, 10, 11, 0.6)",
      "box-shadow": "inset 1px 1px 0 rgba(255, 255, 255, 0.08)"
    },
    "pearl-btn": {
      "background": "linear-gradient(135deg, #F0EAD6 0%, #FBFCF8 50%, #F0EAD6 100%)",
      "color": "#131316",
      "padding": "12px 18px",
      "radius": "9999px",
      "shadow": "0 4px 20px rgba(240, 234, 214, 0.4)",
      "font": "Varela Round 600",
      "hover": "filter: brightness(1.05)",
      "active": "transform: scale(0.97)"
    },
    "ghost-btn": {
      "background": "rgba(255, 255, 255, 0.06)",
      "color": "#FFFFFF",
      "border": "1px solid rgba(15, 10, 11, 0.6)",
      "radius": "9999px",
      "padding": "12px 18px",
      "hover-bg": "rgba(255, 255, 255, 0.12)",
      "hover-border": "rgba(240, 234, 214, 0.5)"
    },
    "picker-card": {
      "background": "rgba(45, 30, 30, 0.35)",
      "border": "1px solid rgba(15, 10, 11, 0.6)",
      "radius": "16px",
      "padding": "12px 14px",
      "checked-border": "rgba(240, 234, 214, 0.55)",
      "checked-background": "rgba(240, 234, 214, 0.10)",
      "checked-shadow": "0 0 22px rgba(240, 234, 214, 0.18)"
    },
    "status-pill": {
      "container": "glass-panel-light + radius:9999px + padding:6px 12px",
      "dot": { "size": "8px", "color": "#F0EAD6", "glow": "0 0 10px rgba(240, 234, 214, 0.9)", "animation": "pulseGlow 2.4s ease-in-out infinite" }
    },
    "slider": {
      "track-height": "6px",
      "track-fill": "#F0EAD6",
      "track-bg": "rgba(255,255,255,0.12)",
      "thumb-size": "18px",
      "thumb-bg": "#F0EAD6",
      "thumb-border": "2px solid #fff",
      "thumb-shadow": "0 0 12px rgba(240, 234, 214, 0.9)"
    },
    "tool-tile": {
      "base": "glass-panel + radius:24px + aspect-square + p:16px",
      "icon-chip": "44x44, radius:12px, bg: rgba(255,255,255,0.08), border: glass-edge, icon-color: #F0EAD6",
      "hover": "translateY(-2px); border-color: rgba(240, 234, 214, 0.45)"
    },
    "top-app-bar": {
      "layout": "fixed top, 56px, max-width 480px, centered",
      "icon-button": "40x40 circle, bg: rgba(255,255,255,0.1), border: glass-edge, backdrop-blur"
    },
    "bottom-nav": {
      "layout": "fixed bottom, glass-panel, radius-top:24px, height:64px",
      "fab": "56x56 pearl gradient, centered, raised -24px",
      "shadow": "0 -4px 20px rgba(0,0,0,0.2)"
    }
  }
}
